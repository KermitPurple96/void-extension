{
  "manifest_version": 3,
  "name": "Void Extension",
  "version": "1.0.0",
  "description": "Security research toolkit — Intercept, Repeater, Endpoint Discovery, Tech Recon",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "debugger",
    "scripting",
    "alarms",
    "cookies",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://localhost:* http://localhost:*"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "probe/config.js",
        "probe/utils.js",
        "probe/highlighter.js",
        "probe/scanner.js",
        "probe/flows.js",
        "probe/hooks.js",
        "probe/probe.js",
        "probe/fuzzer-helpers.js",
        "probe/fuzzer-core.js",
        "probe/fuzzer-tools.js",
        "probe/fuzzer-autofill.js",
        "probe/frameworks.js",
        "probe/reporter.js",
        "probe/main.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
